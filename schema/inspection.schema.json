{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inspection",
  "type": "object",

  "properties": {

    "schemaVersion": {
      "type": "string"
    },

    "inspection": {
      "type": "object",
      "required": ["inspectionId","type","providerId"],
      "properties": {

        "inspectionId": { "type": "string" },

        "type": { "type": "string" },

        "providerId": { "type": "string" },

        "locationId": { "type": "string" },

        "startDate": { "type": "string", "format": "date" },

        "endDate": { "type": "string", "format": "date" }

      }
    },

    "items": {

      "type": "array",

      "items": {

        "type": "object",

        "required": ["itemId","compliance"],

        "properties": {

          "itemId": { "type": "string" },

          "requirement": { "type": "string" },

          "verificationMethod": { "type": "string" },

          "compliance": {
            "type": "string",
            "enum": [
              "Compliant",
              "Non-compliant",
              "Partially Compliant",
              "Not applicable"
            ]
          }

        }
      }

    }

  }

}
