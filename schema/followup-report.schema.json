{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FollowUpReport",
  "type": "object",
  "required": ["schemaVersion", "followUpReport"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "followUpReport": {
      "type": "object",
      "required": [
        "findingId",
        "providerId",
        "locationId",
        "locationName",
        "followUpDate",
        "percentComplete",
        "effectivenessConfirmed",
        "specialtyId"
      ],
      "properties": {
        "contentType": { "type": "string" },
        "findingId": {
          "type": "string",
          "pattern": "^H-[A-Z0-9]{4}[A-Z]\\d{4}-[A-Z]{3,4}-\\d{3}$"
        },
        "followUpId": {
          "type": "string",
          "pattern": "^S-[A-Z0-9]{4}[A-Z]\\d{4}-[A-Z]{3,4}\\d{3}-\\d{2}$"
        },
        "inspectionId": { "type": "string" },
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "locationId": { "type": "string" },
        "locationCode": { "type": "string" },
        "locationName": { "type": "string" },
        "followUpType": {
          "type": "string",
          "enum": [
            "Progress Review",
            "CAP Verification",
            "Closure Verification",
            "Ad-hoc Inquiry"
          ]
        },
        "followUpDate": { "type": "string" },
        "percentComplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "followUpClosureDate": { "type": "string", "format": "date" },
        "closureVerificationMethod": { "type": "string" },
        "effectivenessConfirmed": { "type": ["boolean", "null"] },
        "currentResidualRisk": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "specialtyId": { "type": "string" },
        "specialtyCode": { "type": "string" },
        "specialtyName": { "type": "string" },
        "capId": {
          "type": ["string", "null"],
          "pattern": "^P-[A-Z0-9]{4}[A-Z]\\d{4}-[A-Z]{3,4}\\d{3}-\\d{2}$"
        },
        "followUpComment": { "type": "string" },
        "evidenceItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidenceId"],
            "properties": {
              "evidenceId": { "type": "string" },
              "evidenceType": { "type": "string" },
              "source": { "type": "string" },
              "collectionDate": { "type": "string", "format": "date" },
              "hashValue": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "immutable": { "type": "boolean" },
              "sealedDate": { "type": "string", "format": "date-time" },
              "evidenceRole": {
                "type": "string",
                "enum": [
                  "Compliance Evidence",
                  "Finding Support",
                  "Progress Evidence",
                  "Closure Evidence"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["effectivenessConfirmed"],
            "properties": {
              "effectivenessConfirmed": { "const": true }
            }
          },
          "then": {
            "required": ["followUpType"],
            "properties": {
              "followUpType": { "const": "Closure Verification" }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
