{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FollowUpReport",
  "type": "object",
  "required": ["schemaVersion", "followUpReport"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "followUpReport": {
      "type": "object",
      "required": [
        "findingId",
        "providerId",
        "locationId",
        "locationName",
        "followUpDate",
        "findingClosed",
        "percentComplete",
        "effectivenessConfirmed",
        "specialtyId"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}\\d{3}-[A-Z0-9]{3,6}-\\d{2}$"
        },
        "followUpId": {
          "type": "string",
          "pattern": "^FU-[A-Z0-9]{4}\\d{3}[A-Z0-9]{3,6}-\\d{2}-\\d{6}$"
        },
        "providerId": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "followUpDate": { "type": "string" },
        "findingClosed": { "type": "boolean" },
        "percentComplete": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "effectivenessConfirmed": { "type": "boolean" },
        "specialtyId": { "type": "string" },
        "capId": {
          "type": "string",
          "pattern": "^CA-[A-Z0-9]{4}\\d{3}[A-Z0-9]{3,6}-\\d{2}-\\d{2}$"
        },
        "notes": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidenceId"],
            "properties": {
              "evidenceId": { "type": "string" },
              "evidenceType": { "type": "string" },
              "evidenceSource": { "type": "string" },
              "source": { "type": "string" },
              "hashValue": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "immutable": { "type": "boolean" },
              "sealedDate": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
