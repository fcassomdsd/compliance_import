{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "type": "object",
  "required": ["schemaVersion", "finding"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "finding": {
      "type": "object",
      "required": ["findingId", "providerId", "locationId", "locationName", "itemCode", "description"],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}\\d{3}-[A-Z0-9]{3,6}-\\d{2}$"
        },
        "specialtyId": { "type": "string" },
        "specialtyCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,6}$"
        },
        "specialtyName": { "type": "string" },
        "providerId": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "locationCode": { "type": "string" },
        "itemId": { "type": "string" },
        "itemCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}-\\d{4}$"
        },
        "requirementBreached": { "type": "string" },
        "regulationBreached": { "type": "string" },
        "dateIssued": { "type": "string", "format": "date" },
        "findingLevel": {
          "type": "string",
          "enum": ["Non-Compliance", "Observation", "Recommendation"]
        },
        "description": { "type": "string" },
        "riskLevel": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "riskClassification": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        }
      }
    }
  }
}