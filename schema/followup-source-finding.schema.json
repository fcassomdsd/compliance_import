{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FollowUpSourceFinding",
  "type": "object",
  "required": [
    "findingId",
    "specialtyId",
    "specialtyCode",
    "specialtyName",
    "providerId",
    "locationId",
    "locationCode",
    "locationName",
    "itemId",
    "itemCode",
    "description"
  ],
  "properties": {
    "findingId": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}-[A-Z]{3}-\\d{4}-\\d{2}(?:-\\d{2})?$"
    },
    "specialtyId": { "type": "string" },
    "specialtyCode": { "type": "string" },
    "specialtyName": { "type": "string" },
    "providerId": { "type": "string" },
    "locationId": { "type": "string" },
    "locationCode": { "type": "string" },
    "locationName": { "type": "string" },
    "itemId": { "type": "string" },
    "itemCode": { "type": "string" },
    "requirementBreached": { "type": "string" },
    "dateIssued": { "type": "string" },
    "findingLevel": { "type": "string" },
    "description": { "type": "string" },
    "nominalRisk": { "type": "string" },
    "riskClassification": { "type": "string" },
    "riskLevel": { "type": "string" },
    "findingStatus": { "type": "string" },
    "correctiveAction": {
      "type": "object",
      "properties": {
        "capId": { "type": "string" },
        "proposedAction": { "type": "string" },
        "responsibleEntity": { "type": "string" },
        "dueDate": { "type": "string" },
        "acceptanceStatus": { "type": "string" }
      },
      "required": ["capId"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
