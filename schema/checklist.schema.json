{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checklist",
  "type": "object",
  "required": ["schemaVersion", "checklist", "items"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "checklist": {
      "type": "object",
      "required": ["inspectionId", "inspectionCode", "specialtyId", "specialtyCode", "specialtyName", "providerId"],
      "properties": {
        "contentType": { "type": "string" },
        "inspectionId": { "type": "string" },
        "inspectionCode": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}-[A-Z]-\\d{4}$"
        },
        "scope": { "type": "string" },
        "completionDate": { "type": "string", "format": "date" },
        "locationId": { "type": "string" },
        "locationCode": { "type": "string" },
        "locationName": { "type": "string" },
        "specialtyId": { "type": "string" },
        "specialtyCode": {
          "type": "string",
          "pattern": "^[A-Z]{3,4}$"
        },
        "specialtyName": { "type": "string" },
        "checklistId": {
          "type": "string",
          "pattern": "^LV-[A-Z0-9]{4}[A-Z]\\d{4}-[A-Z]{3,4}$"
        },
        "providerId": { "type": "string" },
        "providerName": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemId", "itemCode"],
        "additionalProperties": false,
        "properties": {
          "itemId": { "type": "string" },
          "itemCode": {
            "type": "string",
            "pattern": "^[A-Z]{3,4}-\\d{4}$"
          },
          "requirement": { "type": "string" },
          "requirementText": { "type": "string" },
          "verificationMethod": { "type": "string" },
          "itemVerificationMethod": { "type": "string" },
          "comment": { "type": "string" },
          "inspectorComment": { "type": "string" },
          "reference": {
            "type": "object",
            "properties": {
              "icaoReference": { "type": "string" },
              "nationalRegulation": { "type": "string" },
              "usoapPqReference": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "criticalElement": { "type": "string" },
                    "areaCode": { "type": "string" }
                  }
                }
              }
            }
          },
          "compliance": {
            "type": "string",
            "enum": ["Compliant", "Non-compliant", "Not applicable"]
          },
          "complianceStatus": {
            "type": "string",
            "enum": ["Compliant", "Non-Compliant", "Not Applicable"]
          },
          "riskLevel": {
            "type": "string",
            "enum": ["Low", "Medium", "High", "Critical"]
          },
          "nominalRisk": {
            "type": "string",
            "enum": ["Low", "Medium", "High", "Critical"]
          },
          "hasOpenPriorFinding": {
            "type": "boolean"
          },
          "evidenceItems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["evidenceId"],
                "properties": {
                  "evidenceId": { "type": "string" },
                  "evidenceType": { "type": "string" },
                  "source": { "type": "string" },
                  "collectionDate": { "type": "string", "format": "date" },
                  "hashValue": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "immutable": { "type": "boolean" },
                  "sealedDate": { "type": "string", "format": "date-time" },
                  "evidenceRole": {
                    "type": "string",
                    "enum": [
                      "Compliance Evidence",
                      "Finding Support",
                      "Progress Evidence",
                      "Closure Evidence"
                    ]
                  }
                }
              }
          }
        }
      }
    }
  }
}