# compliance_import - Docker environment template. Copy to .env.
#
# ---------------------------------------------------------------------------
# Secrets do not have to live in this file.
#
# ALFRESCO_USERNAME, ALFRESCO_PASSWORD and IMPORT_API_KEY each resolve by
# precedence (see secret_config.py):
#
#   1. <NAME>_FILE          a path to a file holding the value
#   2. /run/secrets/<name>  a Docker/Compose secret, lowercase name
#   3. <NAME>               this file / a plain environment variable
#
# The Alfresco credentials already worked this way; IMPORT_API_KEY now does
# too. docker-compose.yml mounts alfresco_username and alfresco_password as
# Docker secrets, which is the pattern to follow for the key. That is the seam
# a secret manager writes into -- nothing here changes when one is introduced,
# and the key is re-read per request, so rotating the file takes effect without
# a restart.
#
# If <NAME>_FILE is set and the file is missing or empty, startup fails rather
# than quietly falling back to the environment variable: a silent fallback is
# how a failed secret rotation looks like a successful one.
#
# Set APP_ENV=production to enable the startup guard. It refuses to start when
# a required secret is missing -- including IMPORT_API_KEY, because leaving it
# unset does not fail closed, it disables the API-key check and leaves the
# ingestion endpoints open -- and when any secret still holds a value published
# in this repository, such as the demo key below.
# ---------------------------------------------------------------------------

# Copy this file to .env before running docker compose.

# Log format: json | text. Left empty it follows APP_ENV -- JSON when
# APP_ENV=production, text otherwise. JSON is what makes these logs queryable
# by field in Loki rather than only greppable, and every line carries a
# request_id so one upload's lines can be told from another's under
# concurrent load. See atrocore-docker/observability.
#
# Alfresco tickets are stripped out of logged URLs in BOTH formats -- a
# ticket in a development log is still a live credential.
LOG_FORMAT=

ALFRESCO_URL=http://proxy:8080/alfresco/api/-default-/public/alfresco/versions/1
ALFRESCO_CANONICAL_JSON_PATH=Sites/vigilancia-de-la-so/documentLibrary/Vigilancia/Datos de campo

# Requires a matching X-API-Key header on every request when set. Must match API_KEY in
# the compliance_flow deployment (and NODE_RED_API_KEY in compliance_web's) — compliance_checklist
# stores a single key and sends it to both. The value below is a PUBLIC PLACEHOLDER, committed
# to this repo — change it, together with the matching values in the other two services, before
# any deployment reachable by anyone you do not trust. Leave unset only in development.
IMPORT_API_KEY=demo-only-CHANGE-BEFORE-ANY-PUBLIC-DEPLOYMENT
ALFRESCO_TIMEOUT_SECONDS=20
ALFRESCO_RETRY_TOTAL=3
ALFRESCO_RETRY_CONNECT=3
ALFRESCO_RETRY_READ=1
ALFRESCO_RETRY_STATUS=3
ALFRESCO_RETRY_BACKOFF_SECONDS=0.5

# ---------------------------------------------------------------------------
# BIND_IP — which host interface published ports listen on.
#
# Default 0.0.0.0 (all interfaces) keeps the demo and CI working: the
# quickstart and demo-verify-ci.sh reach services over the network, and under
# dind DEMO_HOST is `docker`, not localhost, so a hardcoded loopback bind
# would break the whole-stack guard.
#
# A production deployment sets BIND_IP=127.0.0.1 so every service is reachable
# only from the host itself, and the single TLS edge (compliance_web's
# frontend-tls, host 443) is the only externally published port. See
# "An ideal production configuration.md" section 2.3.
BIND_IP=0.0.0.0
